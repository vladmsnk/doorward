{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentbox.dev/schema/v0/approval.schema.json",
  "title": "Approval",
  "description": "Record of one approval request for one exact call: what the approvers saw, who voted, and how each of them signed in. An approved request lets the STS issue a single-use grant bound to action_hash.",
  "type": "object",
  "required": [
    "id",
    "created",
    "status",
    "task",
    "grant",
    "agent",
    "user",
    "action",
    "action_hash",
    "policy_version",
    "required",
    "votes"
  ],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "created": { "$ref": "common.schema.json#/$defs/timestamp" },
    "status": { "enum": ["pending", "approved", "rejected", "expired"] },
    "closed": {
      "description": "When the request stopped being pending.",
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "task": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/id" },
        "type": { "$ref": "common.schema.json#/$defs/name" }
      },
      "additionalProperties": false
    },
    "grant": {
      "description": "jti of the grant the call was made under.",
      "$ref": "common.schema.json#/$defs/id"
    },
    "agent": { "$ref": "common.schema.json#/$defs/name" },
    "user": {
      "description": "The user the agent acts for. Never one of the approvers.",
      "$ref": "common.schema.json#/$defs/subjectId"
    },
    "action": {
      "description": "The call in canonical form, exactly as the approvers saw it.",
      "type": "object",
      "required": ["name", "location", "arguments"],
      "properties": {
        "name": { "$ref": "common.schema.json#/$defs/operation" },
        "location": { "$ref": "common.schema.json#/$defs/audience" },
        "arguments": { "type": "object" }
      },
      "additionalProperties": false
    },
    "action_hash": {
      "description": "Digest of action's canonical form (RFC 8785). The single-use grant is bound to it.",
      "$ref": "common.schema.json#/$defs/digest"
    },
    "policy_version": {
      "description": "The policy in force when the request was made. A change of policy voids the request.",
      "$ref": "common.schema.json#/$defs/digest"
    },
    "required": {
      "description": "How many distinct approvals were needed, from the task type.",
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "votes": {
      "description": "Every vote cast, in order.",
      "type": "array",
      "items": { "$ref": "#/$defs/vote" }
    },
    "single_use_grant": {
      "description": "jti of the single-use grant the STS issued once the request was approved.",
      "$ref": "common.schema.json#/$defs/id"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "description": "An open request has no closing time and no grant.",
      "if": { "properties": { "status": { "const": "pending" } } },
      "then": { "properties": { "closed": false, "single_use_grant": false } },
      "else": { "required": ["closed"] }
    },
    {
      "description": "Only an approved request leads to a grant.",
      "if": { "properties": { "status": { "const": "approved" } } },
      "then": { "properties": { "votes": { "minItems": 1 } } },
      "else": { "properties": { "single_use_grant": false } }
    }
  ],
  "$defs": {
    "vote": {
      "type": "object",
      "required": ["approver", "verdict", "time", "auth_time"],
      "properties": {
        "approver": { "$ref": "common.schema.json#/$defs/subjectId" },
        "verdict": { "enum": ["approve", "reject"] },
        "time": { "$ref": "common.schema.json#/$defs/timestamp" },
        "auth_time": {
          "description": "When the approver signed in for this vote; no earlier than the task type's max_auth_age allows.",
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "acr": {
          "description": "How strongly the approver signed in (OIDC acr).",
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "amr": {
          "description": "Methods the approver signed in with (RFC 8176).",
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 64 },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  }
}
