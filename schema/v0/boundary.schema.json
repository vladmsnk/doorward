{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentbox.dev/schema/v0/boundary.schema.json",
  "title": "Boundary",
  "description": "The most one agent may ever be granted: the boundary is a maximum. metadata.name is the agent's name. A task grant is the task type intersected with this boundary, never more.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "$ref": "common.schema.json#/$defs/apiVersion" },
    "kind": { "const": "Boundary" },
    "metadata": { "$ref": "common.schema.json#/$defs/metadata" },
    "spec": {
      "type": "object",
      "required": ["owner", "task_types", "max_sensitivity", "max_ttl", "permissions"],
      "properties": {
        "owner": {
          "description": "Who answers for this agent.",
          "type": "object",
          "required": ["team"],
          "properties": {
            "team": { "$ref": "common.schema.json#/$defs/name" },
            "contact": { "type": "string", "format": "email" }
          },
          "additionalProperties": false
        },
        "task_types": {
          "description": "Task types this agent may be started for.",
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/name" },
          "minItems": 1,
          "uniqueItems": true
        },
        "max_sensitivity": {
          "description": "Highest tier of operation this agent may be granted.",
          "$ref": "common.schema.json#/$defs/sensitivity"
        },
        "max_ttl": {
          "description": "Longest lifetime of any grant to this agent.",
          "$ref": "common.schema.json#/$defs/duration"
        },
        "permissions": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/permission" },
          "minItems": 1
        },
        "limits": {
          "description": "Per-task ceilings: a task type's limit with the same name is capped at this max.",
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/limit" }
        },
        "delegation": { "$ref": "common.schema.json#/$defs/delegation" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
