{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentbox.dev/schema/v0/tasktype.schema.json",
  "title": "TaskType",
  "description": "A kind of task an application may start. The application sends only the task type and the object ID; the scope comes from here. The issuer, not the agent, defines the task.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "$ref": "common.schema.json#/$defs/apiVersion" },
    "kind": { "const": "TaskType" },
    "metadata": { "$ref": "common.schema.json#/$defs/metadata" },
    "spec": {
      "type": "object",
      "required": ["object", "initiators", "ttl", "permissions"],
      "properties": {
        "object": {
          "description": "What the task is about: the type of object and the shape of its ID.",
          "type": "object",
          "required": ["type", "id_pattern"],
          "properties": {
            "type": { "$ref": "common.schema.json#/$defs/name" },
            "id_pattern": {
              "description": "Regular expression an object ID must match in full.",
              "type": "string",
              "format": "regex",
              "pattern": "^\\^.*\\$$"
            }
          },
          "additionalProperties": false
        },
        "initiators": {
          "description": "Applications allowed to start this task type.",
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/name" },
          "minItems": 1,
          "uniqueItems": true
        },
        "ttl": {
          "description": "Lifetime of the task's root grant; capped by each agent's max_ttl.",
          "$ref": "common.schema.json#/$defs/duration"
        },
        "permissions": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/permission" },
          "minItems": 1
        },
        "limits": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/limit" }
        },
        "delegation": { "$ref": "common.schema.json#/$defs/delegation" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
