{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentbox.dev/schema/v0/tasktype.schema.json",
  "title": "TaskType",
  "description": "A kind of task an application may start. The application sends only the task type and the object ID; the scope comes from here. The issuer, not the agent, defines the task.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "$ref": "common.schema.json#/$defs/apiVersion" },
    "kind": { "const": "TaskType" },
    "metadata": { "$ref": "common.schema.json#/$defs/metadata" },
    "spec": {
      "type": "object",
      "required": ["object", "initiators", "ttl", "permissions"],
      "properties": {
        "object": {
          "description": "What the task is about: the type of object and the shape of its ID.",
          "type": "object",
          "required": ["type", "id_pattern"],
          "properties": {
            "type": { "$ref": "common.schema.json#/$defs/name" },
            "id_pattern": {
              "description": "Regular expression an object ID must match in full.",
              "type": "string",
              "format": "regex",
              "pattern": "^\\^.*\\$$"
            }
          },
          "additionalProperties": false
        },
        "initiators": {
          "description": "Applications allowed to start this task type.",
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/name" },
          "minItems": 1,
          "uniqueItems": true
        },
        "ttl": {
          "description": "Lifetime of the task's root grant; capped by each agent's max_ttl.",
          "$ref": "common.schema.json#/$defs/duration"
        },
        "permissions": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/permission" },
          "minItems": 1
        },
        "limits": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/limit" }
        },
        "delegation": { "$ref": "common.schema.json#/$defs/delegation" },
        "approval": {
          "description": "Who approves this task's calls that need approval, such as critical operations. Approvers are distinct people and never the user the task runs for.",
          "type": "object",
          "required": ["required", "approvers", "max_auth_age", "expires_after"],
          "properties": {
            "required": {
              "description": "How many distinct people must approve. A critical operation always needs at least 2.",
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "approvers": {
              "description": "Members of these groups at this identity provider may approve.",
              "type": "object",
              "required": ["issuer", "groups"],
              "properties": {
                "issuer": { "type": "string", "format": "uri" },
                "groups": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1, "maxLength": 255 },
                  "minItems": 1,
                  "uniqueItems": true
                }
              },
              "additionalProperties": false
            },
            "max_auth_age": {
              "description": "An approver must have signed in this recently; an older session signs in again before voting.",
              "$ref": "common.schema.json#/$defs/duration"
            },
            "acr_values": {
              "description": "Authentication context classes an approver's sign-in must have (OIDC acr).",
              "type": "array",
              "items": { "type": "string", "minLength": 1, "maxLength": 255 },
              "minItems": 1,
              "uniqueItems": true
            },
            "expires_after": {
              "description": "How long an approval request stays open.",
              "$ref": "common.schema.json#/$defs/duration"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
